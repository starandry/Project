{
    "name": "my-react19-project",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint-staged": "lint-staged",
        "format": "prettier --write .",
        "check": "npm run lint && npm run format",
        "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "prepare": "husky",
        "preview": "vite preview"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.3.0",
        "@types/leaflet": "^1.9.21",
        "antd": "^5.24.9",
        "axios": "^1.7.7",
        "dayjs": "^1.11.19",
        "leaflet": "^1.9.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-leaflet": "^5.0.0",
        "react-redux": "^9.1.2",
        "react-router-dom": "^6.28.0",
        "react-select": "^5.10.2",
        "swiper": "^11.2.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@types/node": "^25.0.9",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^8.12.2",
        "@typescript-eslint/parser": "^8.12.2",
        "@vitejs/plugin-react": "^4.3.3",
        "eslint": "^9.13.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "globals": "^15.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.10",
        "prettier": "^3.3.3",
        "sass": "^1.80.6",
        "svgo": "^3.3.2",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.10.0",
        "vite": "^7.1.9",
        "vite-plugin-svgr": "^4.3.0"
    },
    "description": "Проект построен на **React + TypeScript** с использованием **Redux Toolkit** и **React Router v6**.   Основная точка входа — `main.tsx`, в котором подключаются все провайдеры и инициализируется приложение.   Компоненты структурированы по слоям (`layouts`, `pages`, `components`, `stores`, `hooks`, `utils` и т.д.) для удобства поддержки.",
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,scss,md,json,yaml,yml}": [
            "prettier --write"
        ]
    },
    "main": "eslint.config.js",
    "keywords": [],
    "author": "",
    "license": "ISC"
}
